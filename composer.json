{
    "version": "2.0.0",
    "name": "contipay/php-sdk",
    "description": "The Contipay PHP Client provides a simple and secure way to integrate Contipay payments into any PHP application",
    "type": "library",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.5",
        "sanixai/php-utils": "^1.0.1"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "ContiPay\\PhpSdk\\": "src/"
        }
    },
    "authors": [
        {
            "name": "ContiPay",
            "email": "info@contipay.co.zw",
            "homepage": "https://contipay.co.zw",
            "role": "Owner"
        },
        {
            "name": "Nigel Jaure",
            "email": "me@iamnigel.co",
            "homepage": "https://iamnigel.co",
            "role": "Developer"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
